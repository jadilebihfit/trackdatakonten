# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta

# ─── Google Gemini AI ───────────────────────────────────────────────
# Dapatkan gratis di https://aistudio.google.com/
GEMINI_API_KEY=

# ─── Instagram (Instagram Graph API) ───────────────────────────────
# Long-lived token ~60 hari. Sistem akan auto-refresh sebelum expired.
IG_ACCESS_TOKEN=

# ─── Threads ────────────────────────────────────────────────────────
# Long-lived token ~60 hari. Sistem akan auto-refresh sebelum expired.
THREADS_ACCESS_TOKEN=

# ─── YouTube OAuth ──────────────────────────────────────────────────
# OAuth2 credentials dari Google Cloud Console
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ─── Sync Configuration ─────────────────────────────────────────────
# Interval sync otomatis dalam jam (default: 6)
SYNC_INTERVAL_HOURS=6
# Batas umur data sebelum dianggap basi (default: 6)
STALE_AFTER_HOURS=6

# ─── Alert Webhook (Opsional) ───────────────────────────────────────
# URL untuk notifikasi peringatan (Telegram bot, Slack, Discord webhook)
ALERT_WEBHOOK_URL=
